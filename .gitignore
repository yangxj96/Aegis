# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
release/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
*.iml
.idea/

# Keystore files
*.jks
crowdin.properties
.crowdin/config.yml

# Superpowers work files: only its README.md may be tracked
/docs/superpowers/*
!/docs/superpowers/README.md

# Local browser snapshots and debugging output
/.temp/

# Local CodeGraph index
/.codegraph/
